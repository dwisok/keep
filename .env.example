# Birdeye — https://bds.birdeye.so (dashboard → API keys). Standard plan is enough.
BIRDEYE_API_KEY=

# Helius — https://dashboard.helius.dev (free tier works for metadata; transfers need parsed-history quota)
# Solana-only: EVM chains (base, ethereum, …) replay swaps without wallet-to-wallet transfers.
HELIUS_API_KEY=

# GeckoTerminal (Robinhood Chain) needs no key — free tier is ~30 req/min.
# Override the request spacing (ms) if you have a CoinGecko paid plan:
# GECKO_MIN_INTERVAL_MS=2100
